# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=unipos

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# QR sifarişi
# Superadmin serverindəki QR_TABLE_SECRET ilə EYNİ olmalıdır (masa QR tokenlərini yoxlayır)
QR_TABLE_SECRET=at_least_32_random_characters_here
# Socket-ə qoşula bilən brauzer mənbələri (vergüllə). Kassalar (Node) bundan asılı deyil.
SOCKET_CORS_ORIGIN=https://qr.unipos.tech

# QR menyu: nömrə təsdiqi (WhatsApp OTP)
# WhatsApp bot (../Whatsapp Bot) ünvanı və API açarı (bot paneli → Hesab)
WHATSAPP_BOT_URL=http://127.0.0.1:55857
WHATSAPP_BOT_API_KEY=
# Kodların HMAC açarı (uzun, təsadüfi). Boşdursa JWT_SECRET-dən törədilir.
QR_OTP_SECRET=
# 0 — qeydiyyat kodsuz da qəbul olunur (keçid dövrü / bot işləmədikdə). Defolt: məcburi
QR_OTP_REQUIRED=1
# Bütün nömrələrə saatda ən çox neçə kod (WhatsApp nömrəsini ban-dan qoruyur)
QR_OTP_GLOBAL_HOURLY_LIMIT=300
# nginx arxasındadırsa qonağın real IP-si üçün
TRUST_PROXY=
